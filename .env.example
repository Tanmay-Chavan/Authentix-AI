# ─────────────────────────────────────────────────────────────
# Authentix AI — Environment Variables Template
# Copy this file to '.env' and adjust values for your local setup.
# ─────────────────────────────────────────────────────────────

# Application
DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=authentix

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key

# ML Pipeline Settings
DEVICE=auto
BATCH_SIZE=4
